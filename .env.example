# Required for authenticated local-controller API calls.
BOT_API_TOKEN=replace-with-a-long-random-token

# API bind settings for bot-server.
BOT_API_HOST=127.0.0.1
BOT_API_PORT=8080

# Local data directory for JSON persistence.
DATA_DIR=./data
LOG_LEVEL=INFO

# Reserved for later Discord/audio phases.
DISCORD_TOKEN=
# Optional. When set, slash commands are registered to one guild for faster development.
# When blank, commands are registered globally.
DISCORD_COMMAND_GUILD_ID=
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false

# Used by desktop-controller.
BOT_SERVER_URL=http://127.0.0.1:8080
